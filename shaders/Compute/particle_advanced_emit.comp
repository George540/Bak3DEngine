#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

struct Particle
{
    vec4 position; // XYZ = world-space position, W = world-space particle size (radius units)
};

uniform int particle_count;
uniform float spawn_extent = 5.0; // half-extent of the world-space scatter cube, in world units

layout(std430, binding = 16) buffer ParticleBuffer
{
    Particle particles[];
};

// Simple hash function to generate random floats based on a seed vector
float rand(vec2 co)
{
    return fract(sin(dot(co, vec2(12.9898, 78.233))) * 43758.5453);
}

void main()
{
    uint index = gl_GlobalInvocationID.x;
    if (index >= particle_count) // NUM_PARTICLES needs to be passed in via a uniform or UBO
    {
        return;
    }

    // Seed unique to each thread index
    float seedX = float(index) * 0.152;
    float seedY = float(index) * 0.734;
    float seedZ = float(index) * 0.391;
    float seedW = float(index) * 0.912;

    // Generate random world-space coordinates
    float x = (rand(vec2(seedX, 1.0)) * 2.0 - 1.0) * spawn_extent;
    float y = (rand(vec2(seedY, 2.0)) * 2.0 - 1.0) * spawn_extent;
    float z = (rand(vec2(seedZ, 3.0)) * 2.0 - 1.0) * spawn_extent;
    float size = 0.05 + rand(vec2(seedW, 4.0)) * 0.3; // Generate world-space particle "radius", not based on pixel size

    particles[index].position = vec4(x, y, z, 1.0);
}
